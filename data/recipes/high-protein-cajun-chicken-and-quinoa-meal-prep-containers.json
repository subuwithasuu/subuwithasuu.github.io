      "unit": "cup",
      "item": "dry quinoa",
      "metric": "170 g",
      "note": "rinsed well"
    },
    {
      "qty": "2",
      "unit": "cups",
      "item": "low-sodium chicken broth",
      "metric": "480 ml",
      "note": "for cooking quinoa"
    },
    {
      "qty": "4",
      "unit": "cups",
      "item": "broccoli florets",
      "metric": "360 g",
      "note": "fresh"
    },
    {
      "qty": "1",
      "unit": "tbsp",
      "item": "olive oil",
      "metric": "15 ml",
      "note": "divided"
    },
    {
      "qty": "1",
      "unit": "tbsp",
      "item": "Cajun seasoning",
      "metric": "10 g",
      "note": "salt-free or regular"
    },
    {
