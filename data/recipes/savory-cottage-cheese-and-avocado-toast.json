  "ingredients": [
    {
      "qty": "1/2",
      "unit": "cup",
      "item": "low-fat cottage cheese",
      "metric": "113 g",
      "note": "blended until smooth"
    },
    {
      "qty": "1",
      "unit": "slice",
      "item": "sourdough bread",
      "metric": "50 g",
      "note": "toasted until golden brown"
    },
    {
      "qty": "1/2",
      "unit": "medium",
      "item": "ripe avocado",
      "metric": "75 g",
      "note": "sliced"
    },
    {
      "qty": "1",
      "unit": "large",
      "item": "egg",
      "metric": "50 g",
      "note": "soft-boiled"
    },
    {
      "qty": "1/4",
      "unit": "tsp",
      "item": "red pepper flakes",
      "metric": "1 g",
      "note": "for garnish"
    }
  ],
  "steps": [
    "Place the egg in a small saucepan of boiling water over medium-high heat. Boil for 6 minutes, then immediately transfer to an ice bath for 2 minutes before peeling.",
    "Place the sourdough slice in a toaster on a medium setting for 2-3 minutes until golden brown and crisp.",
    "While the bread toasts, blend the cottage cheese in a small food processor or with an immersion blender for 30 seconds until completely smooth and creamy.",
    "Spread the whipped cottage cheese over the warm toast, top with avocado slices, and place the peeled soft-boiled egg on top. Sprinkle with red pepper flakes and serve immediately."
  ],
  "tips": [
    "Blend the cottage cheese the night before to save time during busy mornings.",
    "Ensure the egg is at room temperature before boiling to prevent the shell from cracking."
  ],
  "storage": "Best enjoyed immediately; the avocado will brown if stored for later.",
  "tools": [
    "small saucepan",
    "toaster",
    "small food processor or immersion blender"
  ],
