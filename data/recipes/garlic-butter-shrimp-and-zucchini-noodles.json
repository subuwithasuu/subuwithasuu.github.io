{
  "title": "Garlic Butter Shrimp and Zucchini Noodles",
  "description": "Tender shrimp tossed with garlicky zucchini noodles in a rich butter sauce, ready in 25 minutes. Each serving delivers 35 grams of protein for a light yet satisfying meal.",
  "cuisine": "American",
  "category": "Dinner",
  "servings": 4,
  "protein_g_per_serving": 35,
