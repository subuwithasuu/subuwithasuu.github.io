{
  "title": "Vanilla Berry Greek Yogurt Protein Bowl",
  "description": "This Vanilla Berry Greek Yogurt Protein Bowl packs 35 grams of protein into a quick, refreshing breakfast. It combines creamy strained yogurt with fresh fruit and crunchy toppings for a satisfying morning meal.",
  "cuisine": "American",
  "category": "Breakfast",
  "servings": 1,
  "protein_g_per_serving": 35,
  "prep_minutes": 5,
  "cook_minutes": 0,
