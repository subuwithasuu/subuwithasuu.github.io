  "ingredients": [
    {
      "qty": "1",
      "unit": "cup",
      "item": "plain non-fat Greek yogurt",
      "metric": "225 g",
      "note": "strained"
    },
    {
      "qty": "1",
      "unit": "scoop",
      "item": "vanilla whey protein powder",
      "metric": "30 g",
      "note": "isolate"
    },
    {
      "qty": "1/2",
      "unit": "cup",
      "item": "fresh blueberries",
      "metric": "75 g",
      "note": "washed"
    },
    {
      "qty": "1",
      "unit": "tbsp",
      "item": "chia seeds",
      "metric": "12 g",
      "note": "whole"
    },
    {
      "qty": "2",
      "unit": "tbsp",
      "item": "sliced almonds",
      "metric": "15 g",
      "note": "raw"
    }
  ],
  "steps": [
    "In a medium mixing bowl, combine the Greek yogurt and vanilla protein powder, whisking vigorously for 60 seconds until the powder is fully incorporated and the mixture is smooth.",
    "Fold in half of the blueberries using a silicone spatula until evenly distributed.",
    "Transfer the mixture to a serving bowl, smoothing the top with the back of a spoon.",
    "Garnish the surface with the remaining blueberries, chia seeds, and sliced almonds, serving immediately while chilled."
  ],
  "tips": [
    "If the mixture is too thick, stir in one tablespoon of water or almond milk at a time until the desired consistency is reached.",
    "For added texture, toast the sliced almonds in a dry skillet over medium heat for 2-3 minutes until golden brown and fragrant before adding.",
    "You can prep this in an airtight container the night before, but add the almonds and chia seeds just before eating to keep them crunchy."
  ],
  "storage": "Keep refrigerated in an airtight container for up to 24 hours.",
  "tools": [
    "mixing bowl",
    "whisk",
    "silicone spatula"
  ],
