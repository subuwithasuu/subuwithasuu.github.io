{
  "title": "High-Protein Turkey and Black Bean Burrito Bowls",
  "description": "These high-protein turkey and black bean burrito bowls combine lean ground turkey, seasoned black beans, and fluffy rice for an easy meal prep lunch or dinner. Packed with 35 grams of protein per serving and ready in 25 minutes, they hold up exceptionally well in the refrigerator all week long.",
  "cuisine": "Mexican-American",
  "category": "Meal Prep",
  "servings": 4,
  "protein_g_per_serving": 35,
  "prep_minutes": 10,
  "cook_minutes": 15,
  "total_minutes": 25,
  "ingredients": [
    {
      "qty": "1",
      "unit": "lb",
      "item": "lean ground turkey",
      "metric": "454 g",
      "note": "93% lean"
    },
    {
      "qty": "1",
      "unit": "tbsp",
      "item": "olive oil",
      "metric": "15 ml",
      "note": "divided"
    },
    {
      "qty": "1",
      "unit": "packet",
      "item": "taco seasoning",
      "metric": "28 g",
      "note": "low sodium"
    },
    {
      "qty": "1",
      "unit": "can",
      "item": "black beans",
      "metric": "425 g",
      "note": "rinsed and drained"
    },
    {
      "qty": "2",
      "unit": "cups",
      "item": "cooked long-grain white rice",
      "metric": "320 g",
      "note": "warm"
    },
    {
      "qty": "1",
      "unit": "cup",
      "item": "salsa",
      "metric": "240 g",
      "note": "mild or medium"
    },
    {
      "qty": "1/2",
      "unit": "cup",
      "item": "shredded cheddar cheese",
      "metric": "56 g",
      "note": "divided"
    }
  ],
  "steps": [
    "Heat 1 tablespoon of olive oil in a 12-inch skillet over medium-high heat for 1 minute.",
    "Add the lean ground turkey to the skillet and cook for 6 to 8 minutes, breaking it apart with a wooden spoon, until fully browned and no pink remains, reaching an internal temperature of 160°F (71°C).",
    "Stir the taco seasoning and 1/4 cup of water into the cooked turkey, reduce heat to medium-low, and simmer for 3 minutes until thickened.",
    "In a separate saucepan, warm the rinsed black beans over medium heat for 4 minutes, stirring occasionally until hot.",
    "Divide the warm cooked white rice evenly among 4 meal prep containers.",
    "Top each bed of rice with the seasoned turkey, warmed black beans, salsa, and shredded cheddar cheese. Seal and store in the refrigerator."
  ],
  "tips": [
    "Substitute brown rice or quinoa for the white rice if desired.",
    "Add fresh cilantro or lime wedges just before serving for extra flavor."
  ],
  "storage": "Store in airtight containers in the refrigerator for up to 4 days.",
  "tools": [
    "12-inch skillet",
    "wooden spoon",
    "saucepan",
    "4 meal prep containers"
  ],
