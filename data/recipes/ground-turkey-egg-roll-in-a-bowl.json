      "unit": "tbsp",
      "item": "sesame seeds",
      "metric": "9 g",
      "note": "toasted, for garnish"
    }
  ],
  "steps": [
    "Heat the avocado oil in a 12-inch nonstick skillet over medium-high heat for 1 to 2 minutes until hot and glistening.",
    "Add the ground turkey, minced garlic, and minced ginger to the skillet; cook over medium-high heat for 6 to 8 minutes, breaking up the turkey with a wooden spoon, until no pink remains and the meat reaches an internal temperature of 165°F (74°C).",
    "Pour in the low-sodium soy sauce, toasted sesame oil, and rice vinegar, stirring constantly over medium heat for 1 minute until evenly combined.",
    "Add the coleslaw mix to the skillet and cook over medium heat for 3 to 4 minutes, tossing continuously, until the cabbage is softened and tender-crisp.",
    "Remove the skillet from heat, stir in the sliced green onions, and sprinkle with toasted sesame seeds before serving."
  ],
  "tips": [
    "To add heat, drizzle with sriracha or add 1/2 teaspoon of red pepper flakes with the garlic and ginger.",
    "For meal prep, divide equally into 4 airtight containers once fully cooled."
  ],
  "storage": "Store in airtight containers in the refrigerator for up to 4 days. Reheat gently in the microwave or skillet.",
  "tools": [
    "12-inch nonstick skillet",
    "wooden spoon",
    "instant-read digital meat thermometer"
  ],
