{
  "title": "Sheet Pan Chicken Thighs with Roasted Sweet Potatoes",
  "description": "Sheet pan chicken thighs with roasted sweet potatoes are an easy, high-protein meal prep dish packed with 32g of protein per serving. Tender chicken thighs and sweet potatoes are seasoned with smoked paprika and garlic then roasted to perfection on a single baking sheet.",
  "cuisine": "American",
  "category": "Dinner",
  "servings": 4,
  "protein_g_per_serving": 34,
