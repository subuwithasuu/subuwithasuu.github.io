  "steps": [
    "Preheat the oven to 400°F [200°C] and line a large rimmed baking sheet with parchment paper.",
    "In a small bowl, combine the garlic powder, smoked paprika, onion powder, dried oregano, kosher salt, and black pepper.",
    "Place the cubed sweet potatoes on one side of the baking sheet, drizzle with 1 tbsp (15 ml) of olive oil, and toss with half of the spice blend until thoroughly coated.",
    "Pat the chicken thighs dry with paper towels, place them on the other side of the baking sheet, drizzle with the remaining 1 tbsp (15 ml) of olive oil, and rub evenly with the remaining spice blend.",
    "Roast at 400°F [200°C] for 25 to 30 minutes, stirring the sweet potatoes halfway through, until the sweet potatoes are fork-tender and browned, and the chicken reaches an internal temperature of 165°F (74°C) on an instant-read thermometer.",
    "Remove from the oven, drizzle the fresh lemon juice over the cooked chicken and sweet potatoes, and serve."
  ],
  "tips": [
    "Cut sweet potatoes into uniform 3/4-inch cubes so they roast completely in the same time frame as the chicken thighs.",
    "For extra crispy chicken edges, switch the oven to broil for the final 2 to 3 minutes of cooking."
  ],
  "storage": "Store in airtight containers in the refrigerator for up to 4 days.",
  "tools": [
    "18x13-inch rimmed baking sheet",
    "Parchment paper",
    "Chef's knife",
    "Digital instant-read thermometer"
  ],
