{
  "title": "Crispy Ground Turkey Taco Bowl with Black Beans",
  "description": "This crispy ground turkey taco bowl with black beans packs 35 grams of protein and comes together in just 25 minutes. It features seasoned lean turkey, tender black beans, and fluffy rice for an easy weeknight meal. Save it for your next meal prep.",
  "cuisine": "Mexican-American",
  "category": "Dinner",
  "servings": 4,
  "protein_g_per_serving": 35,
