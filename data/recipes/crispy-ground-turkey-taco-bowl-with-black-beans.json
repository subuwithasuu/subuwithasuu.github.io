  "ingredients": [
    {
      "qty": "1",
      "unit": "lb",
      "item": "lean ground turkey",
      "metric": "454 g",
      "note": "93% lean"
    },
    {
      "qty": "1",
      "unit": "can",
      "item": "black beans",
      "metric": "425 g",
      "note": "rinsed and drained"
    },
    {
      "qty": "1",
      "unit": "packet",
      "item": "taco seasoning",
      "metric": "28 g",
      "note": "low sodium"
    },
    {
      "qty": "1/4",
      "unit": "cup",
      "item": "water",
      "metric": "60 ml",
      "note": "for simmering"
    },
    {
      "qty": "3",
      "unit": "cups",
      "item": "cooked white rice",
      "metric": "480 g",
      "note": "warm"
    },
    {
      "qty": "1",
      "unit": "cup",
      "item": "shredded cheddar cheese",
      "metric": "112 g",
      "note": "divided"
    },
    {
      "qty": "1",
      "unit": "cup",
      "item": "salsa",
      "metric": "240 g",
      "note": "divided"
    }
  ],
  "steps": [
    "Heat a 12-inch skillet over medium-high heat for 2 minutes. Add the lean ground turkey and cook, breaking it apart with a wooden spoon, for 7 to 8 minutes until fully browned and internal temperature reaches 160°F (71°C).",
    "Add the taco seasoning and water to the browned turkey. Reduce heat to medium and simmer for 3 minutes until the liquid reduces and coats the meat.",
    "Add the rinsed black beans to a small saucepan over medium heat, warming them for 3 to 4 minutes until steaming hot, stirring occasionally.",
    "Divide the warm cooked white rice evenly among 4 bowls as the base.",
    "Top each bowl with the crispy seasoned ground turkey, warm black beans, shredded cheddar cheese, and salsa. Serve immediately."
  ],
  "tips": [
    "Substitute brown rice or quinoa for white rice if preferred.",
    "Store leftovers in airtight containers in the refrigerator for up to 4 days.",
    "Reheat in the microwave for 90 seconds until steaming."
  ],
  "storage": "Store in airtight containers in the refrigerator for up to 4 days.",
