  "steps": [
    "In a large mixing bowl, combine 2 cups rolled oats (160 g), 1 cup non-fat plain Greek yogurt (240 g), 2 scoops vanilla whey protein powder (60 g), and 1 1/2 cups unsweetened almond milk (360 ml). Stir vigorously with a wire whisk for 60 seconds until the protein powder is completely dissolved and no dry clumps remain.",
    "Fold in half of the sliced bananas (120 g) and divide the oat mixture evenly across 4 airtight meal prep jars or containers.",
    "Top each jar with 1 tablespoon of natural peanut butter (16 g) and the remaining banana slices (120 g).",
    "Seal the containers tightly with lids and place them in the refrigerator for at least 4 hours, or overnight, until the oats have softened and absorbed the liquid.",
    "Remove from the refrigerator, stir gently if desired, and serve cold once the oats reach a thick, creamy consistency."
  ],
  "tips": [
    "Use a shaker bottle to pre-mix the almond milk and protein powder before pouring over the oats to guarantee a completely smooth texture.",
    "If the mixture thickens too much overnight, stir in an extra splash of almond milk before eating."
  ],
  "storage": "Keep sealed in the refrigerator for up to 4 days.",
  "tools": [
    "large mixing bowl",
    "wire whisk",
    "4 airtight meal prep jars"
  ],
