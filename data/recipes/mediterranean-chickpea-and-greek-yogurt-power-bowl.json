      "unit": "tsp",
      "item": "ground cumin",
      "metric": "3 g",
      "note": "dry spice"
    },
    {
      "qty": "1",
      "unit": "tsp",
      "item": "smoked paprika",
      "metric": "3 g",
      "note": "dry spice"
    },
    {
