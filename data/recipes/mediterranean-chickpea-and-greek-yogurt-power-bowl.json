      "unit": "tsp",
      "item": "kosher salt",
      "metric": "3 g",
      "note": "for chickpeas"
    },
    {
      "qty": "1",
      "unit": "cup",
      "item": "cherry tomatoes, halved",
      "metric": "150 g",
      "note": "fresh"
    },
    {
      "qty": "1",
      "unit": "cup",
      "item": "cucumber, diced",
      "metric": "130 g",
      "note": "fresh"
    }
  ],
  "steps": [
    "In a small bowl, whisk together the Greek yogurt, lemon juice, and salt. Set aside.",
    "Heat olive oil in a large skillet over medium-high heat.",
    "Add the chickpeas, cumin, paprika, and salt to the skillet; sauté for 8-10 minutes, stirring occasionally, until chickpeas are lightly browned and fragrant.",
    "Divide the seasoned yogurt into 4 serving bowls, spreading it to create a base.",
    "Top each bowl with the warm chickpea mixture, followed by the fresh tomatoes, cucumber, and crumbled feta cheese.",
    "Serve immediately."
  ],
  "tips": [
    "Add fresh parsley or mint for extra brightness.",
    "Store the chickpea mixture and yogurt separately to prevent the yogurt from becoming watery.",
    "Use full-fat Greek yogurt for a creamier texture if preferred."
  ],
  "storage": "Store in airtight containers in the refrigerator for up to 3 days.",
